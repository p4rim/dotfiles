     #!/bin/sh

     export XDG_CURRENT_DESKTOP=dwm
     export XDG_SESSION_DESKTOP=dwm
     export XDG_SESSION_TYPE=x11

     if [ -d /etc/X11/xinit/xinitrc.d ]; then
         for script in /etc/X11/xinit/xinitrc.d/?*.sh; do
             [ -x "$script" ] && . "$script"
         done
         unset script
     fi

     exec /usr/bin/dwm

