# Font collection -- keep exactly one font_family line uncommented.
# To switch: comment the active line, uncomment a choice below, save,
# then press Ctrl+Shift+F5 to reload Kitty.
font_family Departure Mono

# Narrow coding font: tight columns, smooth letterforms.
# font_family IosevkaTerm Nerd Font Mono

# Favorite: airy, fine pixel lettering.
# font_family Departure Mono
# Minecraft-style pixels with Nerd Font icons.
# font_family Monocraft
# Smoother, angular Minecraft-inspired lettering (not a strict pixel font).
# font_family Miracode
# Compact, minimalist retro coding font with Nerd Font icons.
# font_family ProggyClean Nerd Font Mono
# Classic compact programming font with Nerd Font icons.
# font_family ProFont IIx Nerd Font Mono
# Chunky DOS-style pixels with Nerd Font icons.
# font_family BigBlueTerm437 Nerd Font Mono
# Original clean, non-pixel fallback.
# font_family Liberation Mono

# Smooth retro / coding collection (all installed).
# IBM mainframe terminal heritage -- try this first for the 1980s mood.
# font_family 3270 Nerd Font Mono
# Hermit: angular, spacious coding letters (Nerd Font name is Hurmit).
# font_family Hurmit Nerd Font Mono
# Hack: clear everyday coding font, with a classic console feel.
# font_family Hack Nerd Font Mono

# Match st's 24-pixel font at 96 DPI (Kitty uses points).
font_size 24 
cursor_shape block
cursor_blink_interval 0
shell_integration no-cursor
background_opacity 0.90
dynamic_background_opacity yes
confirm_os_window_close 0
# Keep the last terminal row flush with the bottom edge.
placement_strategy bottom-left

# Send Ctrl+J (newline) for multiline Codex input, including through tmux.
map shift+enter send_text all \x0a
