font_family Liberation Mono
# Match st's 24-pixel font at 96 DPI (Kitty uses points).
font_size 24 
cursor_shape block
cursor_blink_interval 0
shell_integration no-cursor
background_opacity 0.90
dynamic_background_opacity yes
confirm_os_window_close 0
# Keep the last terminal row flush with the bottom edge.
placement_strategy bottom-left

# Send Ctrl+J (newline) for multiline Codex input, including through tmux.
map shift+enter send_text all \x0a
